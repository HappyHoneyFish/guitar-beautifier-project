/* pages/result/result.wxss */

.result-page {
  height: 100vh;
  padding: 20px;
  box-sizing: border-box;
}

/* 状态容器，确保 Loading 和 Error 居中显示 */
.state-container {
  height: 80vh;
  justify-content: center;
}

/* Win11 风格的极简加载动画：纯色、匀速、不花哨 */
.win-spinner {
  width: 48px;
  height: 48px;
  border: 4px solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.status-msg {
  color: var(--primary-color);
  font-size: 16px;
  font-weight: 500;
  margin-top: 12px;
}

/* 倒计时徽章 */
.time-badge {
  background-color: #E6F2FA; /* 极浅的品牌蓝背景 */
  color: var(--primary-color);
  padding: 6px 16px;
  border-radius: 16px; /* 药丸形状适合做 Tag */
  font-size: 13px;
  font-weight: 600;
}

/* 成功状态容器 */
.success-container {
  height: 100%;
  justify-content: space-between;
}

/* 视频堆叠区 */
.video-stack {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin-bottom: 20px;
}

/* 视频卡片：复用全局卡片样式并修改 padding */
.video-wrapper {
  position: relative;
  height: 46%; /* 上下各占约一半 */
  padding: 0;
  overflow: hidden;
  margin-bottom: 0;
  background-color: #000;
}

.video-wrapper video {
  width: 100%;
  height: 100%;
  display: block;
}

/* 视频左上角的标签 */
.video-label {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 10;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-weight: bold;
  color: #FFF;
  box-shadow: var(--shadow-sm);
}

.bg-dark {
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
}

.bg-primary {
  background-color: var(--primary-color);
}

/* 底部操作区 */
.control-panel {
  width: 100%;
  padding-bottom: env(safe-area-inset-bottom); /* 适配 iPhone 底部黑条 */
}

.btn-block {
  width: 100%;
}

.w-100 {
  width: 100%;
}