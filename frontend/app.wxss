/* app.wxss */

/* 全局样式 */
   page {
    /* 色系 */
    --primary-color: #0078D4;     
    --primary-hover: #005A9E;     
    --bg-color: #F3F3F3;           
    --card-bg: #FFFFFF;           
    --text-main: #1A1A1A;          
    --text-secondary: #5C5C5C;    
    --border-color: #E5E5E5;       
    
    /* 结构与交互规范 */
    --radius-sm: 4px;              
    --radius-md: 8px;              
    --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.04), 0 0 2px rgba(0, 0, 0, 0.06); 
    --shadow-md: 0 4px 8px rgba(0, 0, 0, 0.04), 0 0 2px rgba(0, 0, 0, 0.06); 
  
    /* 字体排版 */
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-main);
    font-size: 14px;
    line-height: 1.5;
    box-sizing: border-box;
  }
  
  /* 全局应用 box-sizing 避免 padding 撑破布局 */
  /* 使用小程序原生标签替代通配符 */
  view, text, scroll-view, image, button, input {
    box-sizing: border-box;
  }
  
  /* 全局通用工具 */
  
  /* 页面基础容器 */
  .container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding: 24px 20px;
  }
  
  /* Fluent 风格标准卡片 */
  .fluent-card {
    background-color: var(--card-bg);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    padding: 20px;
    margin-bottom: 20px;
    border: 1px solid var(--border-color); /* 纯白卡片加一圈极细边框是现代 UI 的精髓哦 */
    transition: box-shadow 0.2s ease;
  }
  
  /* Fluent 风格主按钮 (如：开始录制、保存相册) */
  .fluent-btn-primary {
    background-color: var(--primary-color);
    color: #FFFFFF;
    font-weight: 600;
    font-size: 16px;
    border-radius: var(--radius-sm);
    padding: 14px 24px;
    text-align: center;
    box-shadow: 0 2px 4px rgba(0, 120, 212, 0.2);
    transition: all 0.1s cubic-bezier(0.4, 0, 0.2, 1); /* Win11 的交互反馈极其干脆 */
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  /* 主按钮按下状态 */
  .fluent-btn-primary:active {
    background-color: var(--primary-hover);
    transform: scale(0.98); 
    box-shadow: none;
  }
  
  /* Fluent 风格次要按钮 (如：取消、重录) */
  .fluent-btn-secondary {
    background-color: transparent;
    color: var(--text-main);
    font-weight: 600;
    font-size: 16px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 14px 24px;
    text-align: center;
    transition: all 0.1s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .fluent-btn-secondary:active {
    background-color: rgba(0, 0, 0, 0.04);
    transform: scale(0.98);
  }
  
  /* 排版与布局辅助类 */
  
  /* 大标题 */
  .title-large {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--text-main);
    letter-spacing: -0.5px; /* 稍微收紧字间距，显得更干练 */
  }
  
  /* 辅助说明文字 */
  .text-muted {
    font-size: 13px;
    color: var(--text-secondary);
  }
  
  /* 布局原子类 */
  .flex-center {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .flex-row {
    display: flex;
    flex-direction: row;
    align-items: center;
  }
  
  .flex-col {
    display: flex;
    flex-direction: column;
  }
  
  .mt-20 { margin-top: 20px; }
  .mb-20 { margin-bottom: 20px; }